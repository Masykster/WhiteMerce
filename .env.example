# ---------------------------------------------------------
# WhiteMerce Environment Configuration (Local PostgreSQL 18)
# ---------------------------------------------------------

# Database (Local PostgreSQL 18 default on port 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whitemerce"

# NextAuth v5 (generate with: openssl rand -base64 32)
AUTH_SECRET="dev-whitemerce-auth-secret-change-in-production-32chars"
AUTH_URL="http://localhost:3000"

# Cross-App Origins
STOREFRONT_URL="http://localhost:4321"
ADMIN_URL="http://localhost:3000"

# Multi-Currency Configuration (Default USD, Switchable to IDR)
USD_TO_IDR_RATE="16000"
PUBLIC_API_URL="http://localhost:3000"
API_INTERNAL_URL="http://localhost:3000"
PUBLIC_USD_TO_IDR_RATE="16000"

# Checkout Mode (Dev Test Checkout enabled in development; hard-disabled in production)
ENABLE_DEV_TEST_CHECKOUT="true"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional Docker Port Override (when migrating to Docker alongside local PG 18)
DOCKER_POSTGRES_PORT="5433"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="whitemerce"

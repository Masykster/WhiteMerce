---
import type { SupportedCurrency } from "@whitemerce/shared/constants";
import type { ProductDto } from "@whitemerce/shared/types";
import { PriceTag } from "@/components/islands/PriceTag";

interface Props {
  product: ProductDto;
  initialCurrency: SupportedCurrency;
  idrRate: number;
}

const { product, initialCurrency, idrRate } = Astro.props;
const primaryImage = product.images[0] ?? "/images/products/tee-ivory.svg";
const lowestVariantCents =
  product.variants.length > 0
    ? Math.min(...product.variants.map((v) => v.priceCents))
    : product.basePriceCents;
---

<a
  href={`/products/${product.slug}`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white transition hover:border-stone-400"
>
  <div class="aspect-[4/5] w-full overflow-hidden bg-stone-100">
    <img
      src={primaryImage}
      alt={product.name}
      loading="lazy"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
    />
  </div>

  <div class="flex flex-1 flex-col justify-between gap-3 p-5">
    <div>
      {product.categoryName && (
        <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-stone-400">
          {product.categoryName}
        </p>
      )}
      <h3 class="mt-1 text-base font-medium tracking-tight text-stone-950">
        {product.name}
      </h3>
    </div>

    <div class="flex items-center justify-between border-t border-stone-100 pt-3">
      <PriceTag
        client:load
        usdCents={lowestVariantCents}
        initialCurrency={initialCurrency}
        idrRate={idrRate}
        className="text-sm font-semibold text-stone-950"
      />
      <span class="text-xs text-stone-400">
        {product.variants.length} {product.variants.length === 1 ? "variant" : "variants"}
      </span>
    </div>
  </div>
</a>

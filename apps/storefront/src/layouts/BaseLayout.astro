---
import "@/styles/global.css";
import { getCurrencyFromCookies, getUsdToIdrRate } from "@/lib/api";
import { CurrencySwitcher } from "@/components/islands/CurrencySwitcher";
import { CartButton } from "@/components/islands/CartButton";
import { CartDrawer } from "@/components/islands/CartDrawer";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "WhiteMerce — Architectural Essentials & Objects",
  description = "Minimalist apparel, footwear, accessories, and studio home objects engineered for longevity.",
} = Astro.props;

const initialCurrency = getCurrencyFromCookies(Astro.cookies);
const idrRate = getUsdToIdrRate();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-[#fafaf8] text-[#111111]">
    <header class="sticky top-0 z-30 border-b border-stone-200 bg-[#fafaf8]/90 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
        <div class="flex items-center gap-8">
          <a href="/" class="text-base font-semibold tracking-[0.14em] text-stone-950">
            WHITEMERCE
          </a>
          <nav class="hidden items-center gap-6 text-xs font-medium uppercase tracking-[0.14em] text-stone-600 sm:flex">
            <a href="/products" class="transition hover:text-stone-950">Catalog</a>
            <a href="/orders/lookup" class="transition hover:text-stone-950">Track Order</a>
            <a href="/about" class="transition hover:text-stone-950">Studio</a>
          </nav>
        </div>

        <div class="flex items-center gap-3">
          <CurrencySwitcher client:load initialCurrency={initialCurrency} />
          <CartButton client:load />
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t border-stone-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-col justify-between gap-6 px-5 py-10 text-xs text-stone-500 sm:flex-row sm:items-center sm:px-8">
        <div>
          <p class="font-semibold tracking-[0.14em] text-stone-950">WHITEMERCE</p>
          <p class="mt-1">
            Astro 7 Storefront · React 19 Islands · Next.js 16 Fullstack Core
          </p>
        </div>
        <div class="flex flex-wrap gap-6">
          <a href="/products" class="hover:text-stone-950">Catalog</a>
          <a href="/orders/lookup" class="hover:text-stone-950">Order Tracking</a>
          <a href="/about" class="hover:text-stone-950">About Studio</a>
        </div>
      </div>
    </footer>

    <CartDrawer
      client:idle
      initialCurrency={initialCurrency}
      idrRate={idrRate}
    />
  </body>
</html>

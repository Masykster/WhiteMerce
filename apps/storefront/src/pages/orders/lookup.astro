---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { OrderLookupForm } from "@/components/islands/OrderLookupForm";
---

<BaseLayout title="Track Order — WhiteMerce">
  <div class="mx-auto max-w-4xl space-y-8 px-5 py-12 sm:px-8">
    <div>
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-stone-500">
        Customer Service
      </p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-stone-950">
        Track Your Order
      </h1>
      <p class="mt-2 text-sm text-stone-600">
        Enter your order number (for example, <span class="font-mono">WM-2026-1001</span>)
        and checkout email to inspect real-time fulfillment status.
      </p>
    </div>

    <OrderLookupForm client:load />
  </div>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";

const orderNumber = Astro.url.searchParams.get("orderNumber");
---

<BaseLayout title="Checkout Cancelled — WhiteMerce">
  <div class="mx-auto max-w-xl px-5 py-16 sm:px-8">
    <div class="rounded-2xl border border-stone-200 bg-white p-8 text-center">
      <h1 class="text-2xl font-semibold tracking-tight text-stone-950">
        Checkout Cancelled
      </h1>
      <p class="mt-2 text-sm text-stone-600">
        {orderNumber
          ? `Order ${orderNumber} was cancelled and no payment was charged.`
          : "Your payment session was cancelled and your bag items remain saved."}
      </p>
      <div class="mt-6 flex justify-center gap-3">
        <a
          href="/checkout"
          class="rounded-full bg-stone-950 px-6 py-3 text-sm font-medium text-white"
        >
          Return to Checkout
        </a>
        <a
          href="/products"
          class="rounded-full border border-stone-300 px-6 py-3 text-sm font-medium text-stone-900"
        >
          Browse Products
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

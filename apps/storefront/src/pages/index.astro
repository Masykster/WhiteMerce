---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductCard from "@/components/ProductCard.astro";
import {
  createServerApiClient,
  getCurrencyFromCookies,
  getUsdToIdrRate,
} from "@/lib/api";
import type { CategoryDto, ProductDto } from "@whitemerce/shared/types";

const initialCurrency = getCurrencyFromCookies(Astro.cookies);
const idrRate = getUsdToIdrRate();

let categories: CategoryDto[] = [];
let featuredProducts: ProductDto[] = [];
let apiUnavailable = false;

try {
  const api = createServerApiClient();
  const [catRes, prodRes] = await Promise.all([
    api.listCategories(),
    api.listProducts({ featured: true, limit: 8 }),
  ]);
  categories = catRes.items;
  featuredProducts = prodRes.items;
} catch {
  apiUnavailable = true;
}
---

<BaseLayout title="WhiteMerce — Minimalist Essentials & Objects">
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:items-center lg:py-24">
      <div class="lg:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-stone-500">
          2026 Studio Edition · Zero-JS Edge Storefront
        </p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-stone-950 sm:text-5xl lg:text-6xl">
          Clean Form. Everyday Permanence.
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-stone-600">
          Curated organic cotton garments, architectural footwear, and anodized
          studio objects—delivered globally with instant USD &amp; IDR pricing.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/products"
            class="rounded-full bg-stone-950 px-7 py-3.5 text-sm font-medium text-white transition hover:bg-stone-800"
          >
            Shop Full Catalog
          </a>
          <a
            href="/orders/lookup"
            class="rounded-full border border-stone-300 bg-white px-7 py-3.5 text-sm font-medium text-stone-900 transition hover:bg-stone-100"
          >
            Track Existing Order
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 lg:col-span-5">
        <div class="overflow-hidden rounded-2xl border border-stone-200 bg-stone-100">
          <img
            src="/images/products/tee-ivory.svg"
            alt="Alabaster Heavyweight Tee"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="mt-6 overflow-hidden rounded-2xl border border-stone-200 bg-stone-100">
          <img
            src="/images/products/ceramic-vessel.svg"
            alt="Fluted Ceramic Vessel"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  {apiUnavailable && (
    <div class="mx-auto mt-8 max-w-6xl px-5 sm:px-8">
      <div class="rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-900">
        Storefront could not reach the WhiteMerce backend API. Start the Next.js
        backend at <code>http://localhost:3000</code> and refresh.
      </div>
    </div>
  )}

  {categories.length > 0 && (
    <section class="mx-auto max-w-6xl px-5 pt-16 sm:px-8">
      <div class="flex items-end justify-between">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-stone-500">
            Collections
          </p>
          <h2 class="mt-1 text-2xl font-semibold tracking-tight text-stone-950">
            Browse by Category
          </h2>
        </div>
        <a
          href="/products"
          class="text-xs font-medium text-stone-600 hover:text-stone-950"
        >
          View all →
        </a>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((category) => (
          <a
            href={`/products?category=${category.slug}`}
            class="rounded-2xl border border-stone-200 bg-white p-5 transition hover:border-stone-400"
          >
            <p class="text-base font-semibold text-stone-950">{category.name}</p>
            <p class="mt-1 line-clamp-2 text-xs text-stone-500">
              {category.description}
            </p>
            <p class="mt-4 text-xs font-medium text-stone-900">
              {category.productCount ?? 0} products →
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-5 pt-16 sm:px-8">
    <div class="flex items-end justify-between">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-stone-500">
          Curated Selection
        </p>
        <h2 class="mt-1 text-2xl font-semibold tracking-tight text-stone-950">
          Featured Objects
        </h2>
      </div>
      <a
        href="/products"
        class="text-xs font-medium text-stone-600 hover:text-stone-950"
      >
        Explore catalog →
      </a>
    </div>

    {featuredProducts.length > 0 ? (
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featuredProducts.map((product) => (
          <ProductCard
            product={product}
            initialCurrency={initialCurrency}
            idrRate={idrRate}
          />
        ))}
      </div>
    ) : (
      !apiUnavailable && (
        <p class="mt-6 text-sm text-stone-500">No featured products available.</p>
      )
    )}
  </section>
</BaseLayout>

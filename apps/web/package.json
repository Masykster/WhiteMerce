{
  "name": "@whitemerce/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:bun": "bun --bun next dev --port 3000",
    "build": "next build",
    "build:bun": "bun --bun next build",
    "start": "next start --port 3000",
    "start:bun": "bun ./scripts/start-bun.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun --bun vitest run",
    "db:push": "drizzle-kit push",
    "db:push:bun": "bun --bun drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:generate:bun": "bun --bun drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:bun": "bun src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:bun": "bun --bun drizzle-kit studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@hookform/resolvers": "^7.0.6",
    "@whitemerce/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "stripe": "^23.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
